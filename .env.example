# Environment Configuration
APP_ENV=development
APP_NAME="EduAdapt Generative AI Module"
LOG_LEVEL=INFO

# LLM Inference Provider Configuration
# Supported providers: mock, ollama (unsupported providers will be rejected)
LLM_PROVIDER=mock
LLM_MODEL_NAME=mistral:7b
LLM_API_KEY=
LLM_API_BASE=http://localhost:11434
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=180.0

# Downstream / External Integration Mock Endpoints (Owned by other teams)
RAG_SERVICE_URL=http://localhost:8001
STUDENT_MODEL_SERVICE_URL=http://localhost:8002
ACCESSIBILITY_SERVICE_URL=http://localhost:8003
